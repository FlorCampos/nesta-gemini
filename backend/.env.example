# ============================================
# Nesta AI Backend — Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to GitHub
# ============================================

# Claude — conversations (always required)
ANTHROPIC_API_KEY=

# Supabase — database (always required)
SUPABASE_URL=
SUPABASE_KEY=

# Feature flags
NESTA_ENABLED=true
RERANKER_ENABLED=false

# Models
CLAUDE_MODEL=claude-opus-4-6
EMBEDDING_MODEL=gemini-embedding-2

# ============================================
# EMBEDDING PROVIDER — change per phase:
# ============================================

# Phase 1: Development (free, 1000/day limit)
EMBEDDING_PROVIDER=google_ai_studio
GOOGLE_API_KEY=

# Phase 2: Your Vertex AI (almost unlimited)
# EMBEDDING_PROVIDER=vertex_ai
# GOOGLE_CLOUD_PROJECT=your-project-id

# Phase 3: Mahsa's Vertex AI (production)
# EMBEDDING_PROVIDER=vertex_ai
# GOOGLE_CLOUD_PROJECT=mahsa-project-id

# ============================================
# REDIS :
# ============================================
# Redis — cache (optional, for production)
REDIS_URL=redis://redis:6379